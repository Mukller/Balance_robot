// Balance_robot local secrets — NOT committed to git (see .gitignore).
// Copy this file to "secrets.h" next to the .ino and fill in your values:
//   cp secrets.h.example secrets.h
//
// Two ways to provide WiFi credentials:
//   1) Compile-time (this file): simple, but you must re-flash to change.
//   2) Runtime via web UI: connect to the robot's AP (BalanceRobot-Setup / balance123),
//      open http://192.168.4.1/ and call /api/save-wifi?ssid=...&pass=...
//      These are stored in NVS (Preferences) and survive reboots.
//
// Method 2 is recommended for competition use.

#define WIFI_SSID     "your-ssid"
#define WIFI_PASSWORD "your-password"
